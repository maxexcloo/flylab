#!/usr/bin/env bash
set -euo pipefail

manifest=${1:?Usage: resolve-secrets MANIFEST}
: "${OP_SERVICE_ACCOUNT_TOKEN:?OP_SERVICE_ACCOUNT_TOKEN is required}"

vault_id=$(jq -er '.vault_id' "$manifest")
items=$(
  op item list --vault "$vault_id" --format json |
    jq -c '
      map({
        id,
        key: (.title | split("(") | last | rtrimstr(")"))
      }) |
      group_by(.key) |
      if any(.[]; length != 1) then
        error("Duplicate 1Password resource key")
      else
        map({key: .[0].key, value: .[0].id}) | from_entries
      end
    '
)

while IFS=$'\t' read -r environment_name item_key field_id transform; do
  item_id=$(jq -er --arg key "$item_key" '.[$key]' <<< "$items")
  value=$(
    op item get "$item_id" --vault "$vault_id" --format json |
      jq -er --arg field_id "$field_id" '
        [.fields[] | select(.id == $field_id and .value != null and .value != "")] |
        if length == 1 then .[0].value else error("Missing or duplicate field") end
      '
  )

  case "$transform" in
    basic_monitoring)
      value=$(printf 'monitoring:%s' "$value" | base64 | tr -d '\n')
      ;;
    raw) ;;
    *)
      echo "Unsupported transform for $environment_name: $transform" >&2
      exit 1
      ;;
  esac

  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    echo "Multiline values are not supported: $environment_name" >&2
    exit 1
  fi
  printf '%s=%s\n' "$environment_name" "$value"
done < <(
  jq -er '
    .secrets |
    to_entries[] |
    [.key, .value.item, .value.field, .value.transform] |
    @tsv
  ' "$manifest"
)
