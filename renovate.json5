{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>maxexcloo/dotfiles//renovate/default.json5"],
  packageRules: [
    {
      description: "kubectl matches the cluster `kubernetes_version` owned by Homelab",
      enabled: false,
      matchManagers: ["mise"],
      matchDepNames: ["kubectl"],
    },
  ],
}
