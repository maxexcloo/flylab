{{- defineDatasource "catalog" "env:///HOMELAB_CATALOG?type=application/json" -}}
{{- defineDatasource "deployment" "env:///DEPLOYMENT?type=application/json" -}}
{{- $catalog := ds "catalog" -}}
{{- $deployment := ds "deployment" -}}
{{ printf "MAIL_PASSWORD={{ op://%s/%s/mail_password }}" $catalog.vault_id $deployment.item }}
{{ range $service := $catalog.services -}}
{{ if $service.features.oidc_forward_auth -}}
{{ $key := $service.key | strings.ToUpper | strings.ReplaceAll "-" "_" -}}
{{ printf "MONITORING_BASIC_%s={{ op://%s/%s/monitoring_basic }}" $key $catalog.vault_id $service.item }}
{{ end -}}
{{ end -}}
{{ range $service := $catalog.services -}}
{{ $key := $service.key | strings.ToUpper | strings.ReplaceAll "-" "_" -}}
{{ printf "MONITORING_TOKEN_%s={{ op://%s/%s/monitoring_token }}" $key $catalog.vault_id $service.item }}
{{ end -}}
{{ printf "TAILSCALE_AUTH_KEY={{ op://%s/%s/tailscale_auth_key }}" $catalog.vault_id $deployment.item }}
