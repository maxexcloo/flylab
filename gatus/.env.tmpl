{{- defineDatasource "config" "env:///CONFIG?type=application/json" -}}
{{- defineDatasource "deployment" "env:///DEPLOYMENT?type=application/json" -}}
{{- $config := ds "config" -}}
{{- $deployment := ds "deployment" -}}
{{- printf "MAIL_PASSWORD={{ op://%s/%s/mail_password }}\n" $config.vault_id $deployment.item -}}
{{- range $service := $config.services -}}
  {{- if $service.features.oidc_forward_auth -}}
    {{- $key := $service.key | strings.ToUpper | strings.ReplaceAll "-" "_" -}}
    {{- printf "MONITORING_BASIC_%s={{ op://%s/%s/monitoring_basic }}\n" $key $config.vault_id $service.item -}}
  {{- end -}}
{{- end -}}
{{- range $service := $config.services -}}
  {{- $key := $service.key | strings.ToUpper | strings.ReplaceAll "-" "_" -}}
  {{- printf "MONITORING_TOKEN_%s={{ op://%s/%s/monitoring_token }}\n" $key $config.vault_id $service.item -}}
{{- end -}}
{{- printf "TAILSCALE_AUTH_KEY={{ op://%s/%s/tailscale_auth_key }}\n" $config.vault_id $deployment.item -}}
